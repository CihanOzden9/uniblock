# UniBlock Monorepo .gitignore

# Dependencies
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build & Outputs
**/.next/
**/out/
**/build/
**/dist/
.tsbuildinfo
next-env.d.ts

# Environment Variables & Secrets
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
**/*.pem
**/*.key

# Prisma
**/prisma/migrations/
**/prisma/*.db
**/prisma/*.db-journal
**/src/generated/prisma

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
**/logs/
**/.vercel

# OS Files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# IDEs & Tools
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Testing
**/coverage/
**/.nyc_output

# Temporary & Planning Files
*~
**/~*
**/*.drawio~
**/*.tmp
future/
gelistirme_plani.md

# Tasarım referans materyali (Academic Pulse / UniVerse mockup'ları) — repoya dahil edilmez
tasarım_detayları/

# Claude Code — makineye özel yerel ayarlar
.claude/settings.local.json
